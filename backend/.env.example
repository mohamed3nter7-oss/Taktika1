# Copy to .env and fill in. .env is gitignored; this file is not.

# Must match docker-compose.yml. Note the host port is 5433, not the usual
# 5432: a native PostgreSQL 18 service occupies 5432 on the current dev
# machine, and the app must reach the PostgreSQL 16 container (CLAUDE.md §2).
# If 5432 is free on yours, change both this and the compose port together.
DATABASE_URL="postgresql://myuser:mysecretpassword@localhost:5433/mydatabase?schema=public"

NODE_ENV=development
PORT=3000

# Signs 15-minute access tokens (CLAUDE.md §9).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# MUST differ from JWT_SECRET. Signs the 24-hour email-verification token, so
# neither kind of token can ever be replayed as the other.
EMAIL_VERIFICATION_SECRET=

# Exact frontend origins, comma separated. Never '*' — credentialed CORS
# forbids it, and the refresh cookie needs credentialed requests.
#
# The SameSite trap (§9): SameSite=Strict means API and frontend must share a
# site — api.kooora.com + kooora.com. A *.vercel.app → *.railway.app pair is
# cross-site and the cookie silently never arrives. Fix that with custom
# domains, never by weakening SameSite or CORS.
CORS_ORIGINS=http://localhost:3001

# =============================================================================
# OBJECT STORAGE (media module)
#
# Named by ROLE, never by vendor. Supabase Storage is the development provider
# and Cloudflare R2 is the launch provider; both speak S3 with SigV4, so the
# migration changes these seven VALUES and nothing else. A SUPABASE_* name
# would make it a change to every file that reads one.
#
# All seven are validated at boot (media/storage.config.ts). A missing or
# malformed value stops the process — it does not surface as a failed upload
# three weeks later.
# =============================================================================

# The S3 API endpoint.
#   Supabase: Dashboard → Storage → Settings → S3 Connection → "Endpoint".
#             https://<project_ref>.storage.supabase.co/storage/v1/s3
#   R2 later: https://<account_id>.r2.cloudflarestorage.com
#
# NOTE the hostname: `<ref>.storage.supabase.co`, which is NOT the same host as
# STORAGE_PUBLIC_BASE_URL below. Copy-pasting one into the other gives a config
# where uploads succeed and every public read 404s — which looks exactly like a
# private bucket and sends debugging in the wrong direction.
STORAGE_ENDPOINT=https://your_project_ref.storage.supabase.co/storage/v1/s3

# Supabase: the region shown beside the endpoint in Storage Settings.
# R2 later: auto
STORAGE_REGION=eu-west-1

# Supabase: Storage → Settings → S3 Connection → "New access key". Shown once.
# R2 later: Cloudflare dashboard → R2 → Manage API tokens.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# The bucket. Must exist already — nothing in the app creates it.
STORAGE_BUCKET=media

# Where objects are read from publicly. Derived into a URL in exactly one place
# (StorageService.publicUrl); post_images stores the KEY, never the URL, so
# this line is the entire R2 read-migration surface.
#   Supabase: https://<project_ref>.supabase.co/storage/v1/object/public/<bucket>
#   R2 later: the custom domain bound to the bucket
STORAGE_PUBLIC_BASE_URL=https://your_project_ref.supabase.co/storage/v1/object/public/media

# Required by Supabase; harmless on R2. Without it the SDK rewrites requests to
# a virtual-hosted <bucket>.<endpoint> name that resolves nowhere.
STORAGE_FORCE_PATH_STYLE=true
